{
  "name": "store-web",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "prefix": "store",
  "sourceRoot": "packages/store-web/src",
  "tags": ["type:app", "scope:store"],
  "targets": {
    "build": {
      "executor": "@angular/build:application",
      "outputs": ["{options.outputPath}"],
      "defaultConfiguration": "production",
      "options": {
        "outputPath": "dist/packages/store-web",
        "browser": "packages/store-web/src/main.ts",
        "tsConfig": "packages/store-web/tsconfig.app.json",
        "inlineStyleLanguage": "scss",
        "assets": [
          {
            "glob": "**/*",
            "input": "packages/store-web/public"
          }
        ],
        "styles": ["packages/store-web/src/styles.scss"],
        "server": "packages/store-web/src/main.server.ts",
        "ssr": {
          "entry": "packages/store-web/src/server.ts"
        },
        "outputMode": "server"
      },
      "configurations": {
        "production": {
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "500kb",
              "maximumError": "1mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "4kb",
              "maximumError": "8kb"
            }
          ],
          "outputHashing": "all"
        },
        "development": {
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true
        }
      }
    },
    "serve": {
      "continuous": true,
      "executor": "@angular/build:dev-server",
      "defaultConfiguration": "development",
      "configurations": {
        "production": {
          "buildTarget": "store-web:build:production"
        },
        "development": {
          "buildTarget": "store-web:build:development"
        }
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "test": {
      "executor": "@angular/build:unit-test",
      "options": {
        "watch": false
      }
    },
    "serve-static": {
      "continuous": true,
      "executor": "@nx/web:file-server",
      "options": {
        "buildTarget": "store-web:build",
        "port": 4200,
        "staticFilePath": "dist/packages/store-web/browser",
        "spa": true
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --noEmit --rootDir . -p packages/store-web/tsconfig.app.json"
      },
      "cache": true,
      "inputs": ["default", "^production"]
    }
  }
}
